# ──────────────────────────────────────────────
# 이 파일을 복사해 ".env" 파일을 만들고 값을 채우세요. (.env는 GitHub에 올라가지 않습니다)
# Netlify에서는 Site configuration → Environment variables 에 같은 이름으로 등록합니다.
#
# VITE_FIREBASE_API_KEY 가 비어 있으면 사이트는 "테스트 모드"(이 브라우저에만 저장)로 동작합니다.
# ──────────────────────────────────────────────

# Firebase 콘솔 → 프로젝트 설정 → 내 앱 → SDK 설정 및 구성(firebaseConfig) 값
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 관리자(교수) Google 이메일. 여러 명이면 쉼표로 구분 (예: a@gmail.com,b@gmail.com)
# firestore.rules 안의 관리자 이메일과 반드시 같게 맞춰 주세요.
VITE_ADMIN_EMAILS=

# (선택) 사이트 이름. 비워 두면 "태권도 연구실 아카이브"
VITE_SITE_NAME=
